# File env này là TUỪ CHỌN. Xem docs/deploy-vps.md §2.4.
# Bản chuẩn đặt NGOÀI repo tại /opt/simple-next-secrets/{prod,staging}.env —
# deploy.sh và ecosystem.config.cjs đọc file đó. Local thì copy thành `.env`.

# Hiện ở trang chủ (server-side, đọc lúc request)
APP_MESSAGE=hello from local

# Port Next.js lắng nghe trên loopback. GIÁ TRỊ NÀY KHÔNG ĐƯỢC set trong file env
# trên VPS — deploy.sh truyền PORT theo từng môi trường (prod 3119, staging 3118)
# qua ecosystem.config.cjs, nên đặt ở đây sẽ bị ghi đè.
# PORT=3000

# Hai biến dưới KHÔNG cần set: deploy.sh export từ commit đang deploy
# (NEXT_PUBLIC_GIT_SHA) và thời điểm build (NEXT_PUBLIC_BUILD_TIME).
# Next.js inline chúng vào bundle lúc `npm run build`.
# NEXT_PUBLIC_GIT_SHA=local
# NEXT_PUBLIC_BUILD_TIME=local
